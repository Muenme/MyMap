{
  "info": {
    "_postman_id": "8f2a1b3c-4d5e-6f7a-8b9c-0d1e2f3a4b5c",
    "name": "ComfortMap API",
    "description": "Регрессионные тесты API ComfortMap. Адрес и anon key передаются через environment: host, anon.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "noauth" },
  "header": [
    { "key": "apikey", "value": "{{anon}}", "type": "text" }
  ],
  "variable": [
    { "key": "token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const E = {",
          "  '03 health': { s: 200, check: j => j.status === 'ok' },",
          "  '04 no params': { s: 400, code: 'VALIDATION_ERROR', field: 'lat' },",
          "  '05 lat=abc': { s: 400, code: 'VALIDATION_ERROR', field: 'lat' },",
          "  '06 radius empty': { s: 400, code: 'VALIDATION_ERROR', field: 'radius' },",
          "  '07 radius abc': { s: 400, code: 'VALIDATION_ERROR', field: 'radius' },",
          "  '08 radius 0': { s: 400, code: 'VALIDATION_ERROR', field: 'radius' },",
          "  '09 radius 8000': { s: 422, code: 'RADIUS_TOO_LARGE', field: 'radius' },",
          "  '10 points ok': { s: 200, check: j => Array.isArray(j.data) && j.data.length > 0 && j.data.every(p => p.id && p.type && p.name !== undefined && p.distance_m !== undefined) },",
          "  '11 bad token': { s: 401, code: 'AUTH_TOKEN_INVALID' },",
          "  '12 me no token': { s: 401, code: 'AUTH_TOKEN_MISSING' },",
          "  '13 me ok': { s: 200, check: j => !!(j.id && j.device_id && j.situation_profile && j.role) },",
          "  '14 parse no token': { s: 401, code: 'AUTH_TOKEN_MISSING' },",
          "  '15 parse empty': { s: 400, code: 'VALIDATION_ERROR', field: 'text' },",
          "  '16 parse bad json': { s: 400, code: 'VALIDATION_ERROR' },",
          "  '17 parse bad profile': { s: 400, code: 'VALIDATION_ERROR', field: 'profile' },",
          "  '18 parse toilet': { s: 200, check: j => j.type === 'TOILET' && j.attributes.includes('BABY_CHANGING') && j.radius_m === 300 && j.fallback === false },",
          "  '19 parse unknown': { s: 200, check: j => j.type === null && j.fallback === true },",
          "  '20 unknown path': { s: 404, code: 'NOT_FOUND' }",
          "};",
          "const exp = E[pm.info.requestName];",
          "if (pm.request.url.toString().indexOf('/functions/v1/') !== -1 && pm.response.code >= 400) {",
          "  pm.test('ошибка в едином формате', () => {",
          "    pm.expect(pm.response.json().error).to.have.all.keys('code', 'message', 'details', 'request_id', 'timestamp');",
          "  });",
          "}",
          "if (exp) {",
          "  pm.test('статус ' + exp.s, () => pm.response.to.have.status(exp.s));",
          "  if (exp.code) pm.test('код ' + exp.code, () => pm.expect(pm.response.json().error.code).to.eql(exp.code));",
          "  if (exp.field) pm.test('details.field = ' + exp.field, () => pm.expect(pm.response.json().error.details.field).to.eql(exp.field));",
          "  if (exp.check) pm.test('тело ответа', () => pm.expect(!!exp.check(pm.response.json()), 'тело не совпадает').to.be.true);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "01 signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('вход анонимный, токены сохранены', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.user.is_anonymous).to.eql(true);",
                  "  pm.collectionVariables.set('token', r.access_token);",
                  "  pm.collectionVariables.set('refresh_token', r.refresh_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"device_id\": \"{{$randomUUID}}\"\n  }\n}"
            },
            "url": "{{host}}/auth/v1/signup"
          }
        },
        {
          "name": "02 refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refresh: новые токены сохранены', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const r = pm.response.json();",
                  "  pm.collectionVariables.set('token', r.access_token);",
                  "  pm.collectionVariables.set('refresh_token', r.refresh_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{host}}/auth/v1/token?grant_type=refresh_token"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "03 health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{host}}/functions/v1/api/v1/health"
          }
        }
      ]
    },
    {
      "name": "Points",
      "item": [
        {
          "name": "04 no params",
          "request": { "method": "GET", "header": [], "url": "{{host}}/functions/v1/api/v1/points" }
        },
        {
          "name": "05 lat=abc",
          "request": { "method": "GET", "header": [], "url": "{{host}}/functions/v1/api/v1/points?lat=abc&lng=30.3" }
        },
        {
          "name": "06 radius empty",
          "request": { "method": "GET", "header": [], "url": "{{host}}/functions/v1/api/v1/points?lat=59.9&lng=30.3&radius=" }
        },
        {
          "name": "07 radius abc",
          "request": { "method": "GET", "header": [], "url": "{{host}}/functions/v1/api/v1/points?lat=59.9&lng=30.3&radius=abc" }
        },
        {
          "name": "08 radius 0",
          "request": { "method": "GET", "header": [], "url": "{{host}}/functions/v1/api/v1/points?lat=59.9&lng=30.3&radius=0" }
        },
        {
          "name": "09 radius 8000",
          "request": { "method": "GET", "header": [], "url": "{{host}}/functions/v1/api/v1/points?lat=59.9&lng=30.3&radius=8000" }
        },
        {
          "name": "10 points ok",
          "request": { "method": "GET", "header": [], "url": "{{host}}/functions/v1/api/v1/points?lat=59.9265&lng=30.3616&radius=1000" }
        },
        {
          "name": "11 bad token",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer abc" }
            ],
            "url": "{{host}}/functions/v1/api/v1/points?lat=59.9265&lng=30.3616&radius=1000"
          }
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "12 me no token",
          "request": { "method": "GET", "header": [], "url": "{{host}}/functions/v1/api/v1/me" }
        },
        {
          "name": "13 me ok",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{host}}/functions/v1/api/v1/me"
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "14 parse no token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"text\": \"туалет\"}" },
            "url": "{{host}}/functions/v1/api/v1/search/parse"
          }
        },
        {
          "name": "15 parse empty",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"text\": \"\"}" },
            "url": "{{host}}/functions/v1/api/v1/search/parse"
          }
        },
        {
          "name": "16 parse bad json",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"text\": \"туалет\"",
              "options": { "raw": { "language": "text" } }
            },
            "url": "{{host}}/functions/v1/api/v1/search/parse"
          }
        },
        {
          "name": "17 parse bad profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"text\": \"туалет\", \"profile\": \"PIRATE\"}" },
            "url": "{{host}}/functions/v1/api/v1/search/parse"
          }
        },
        {
          "name": "18 parse toilet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"text\": \"туалет с пеленальным рядом с парком\"}" },
            "url": "{{host}}/functions/v1/api/v1/search/parse"
          }
        },
        {
          "name": "19 parse unknown",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"text\": \"привет как дела\"}" },
            "url": "{{host}}/functions/v1/api/v1/search/parse"
          }
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "20 unknown path",
          "request": { "method": "GET", "header": [], "url": "{{host}}/functions/v1/api/v1/nope" }
        }
      ]
    }
  ]
}
